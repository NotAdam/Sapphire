[Scripts]
; where compiled script modules are located
Path = ./compiledscripts/
; relative to Path, where we copy and load modules from
CachePath = ./cache/
; whether we should detect changes to script modules and reload them
HotSwap = true
; where .luau scripts are loaded from. Unset = the source tree's src/lua_scripts (edit + save = hot reload).
; For a deployment run the copy_lua_scripts target and set: LuauPath = ./scripts/
; LuauPath = ./scripts/
; script types whose globals become read-only once the script has loaded (comma separated, empty = none):
; instance, questbattle, quest, event, action, status, zone, eobj
; A handler that assigns a global in such a script raises an error instead of silently sharing state between players.
LuauReadOnlyGlobals = quest,event,action,status,zone,eobj
; longest a script may run without yielding, in milliseconds, before it is aborted with an error (guards the server
; thread against endless loops). 0 disables the guard.
LuauTimeBudgetMs = 1000

[Network]
ListenIp = 0.0.0.0
ListenPort = 54992
DisconnectTimeout = 20

[General]
; Sent on login - each line must be shorter than 307 characters, split lines with ';'
MotD = Welcome to Sapphire!;This is a very good server;You can change these messages by editing General.MotD in config/config.ini
SkipOpening = true

[Navigation]
MeshPath = navi

[Map]
; true = eager preload ENpcBase/EObj sheets at startup (quests stay lazy)
; false = fully lazy map data loading
EagerENpcEObjCache = true

[Housing]
; Set the default estate name. {0} will be replaced with the plot number
DefaultEstateName = Estate ${0}